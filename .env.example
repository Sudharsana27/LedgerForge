# Copy to .env and edit. Never commit .env to Git.
# Local SQLite is the default for direct Python development.
DATABASE_URL=sqlite:///./ledgerforge.db
# DATABASE_URL=postgresql+psycopg2://ledger:ledger@localhost:5432/ledgerforge
DATA_DIR=../03_Data/csv
SECRET_KEY=
REDIS_URL=redis://localhost:6379/0

# Hosted PostgreSQL URLs using postgres:// or postgresql:// are supported.
# Add ?sslmode=require when required by the hosted provider.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Set the managed Redis-compatible broker URL for production.
# REDIS_URL=rediss://user:password@host:6379/0
